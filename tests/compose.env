# Non-secret parse fixtures; no deployment or network connection.
DB_USER=fixture
DB_PASSWORD=fixture-only
DB_ROOT_PASSWORD=fixture-root-only
REDIS_PASSWORD=fixture-redis-only
KAFKA_EXTERNAL_HOST=localhost
KAFKA_EXTERNAL_PORT=9102
KAFKA_IMAGE=confluentinc/cp-kafka@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
KAFKA_CLUSTER_ID=fixture-prod2-cluster-id
KAFKA_UI_IMAGE=provectuslabs/kafka-ui@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
KAFKA_UI_PORT=9112
KAFKA_UI_TZ=Asia/Seoul
KAFKA_UI_LANG=en_US.UTF-8
KAFKA_UI_JAVA_TOOL_OPTIONS=-Dfile.encoding=UTF-8
KAFKA_UI_USERNAME=fixture
KAFKA_UI_PASSWORD=fixture-only
KAFKA_UI_CLUSTER_NAME=local
KAFKA_UI_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_UI_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_UI_SASL_MECHANISM=PLAIN
KAFKA_UI_SASL_JAAS_CONFIG=
MINIO_IMAGE=sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
MINIO_ROOT_USER=fixture
MINIO_ROOT_PASSWORD=fixture-minio-only
MINIO_SERVER_URL=https://storage.memonogi.com
MINIO_BROWSER_REDIRECT_URL=http://localhost:9000
AUTH_MINIO_ACCESS_KEY=fixture-auth
AUTH_MINIO_SECRET_KEY=fixture-auth-secret-only
AUTH_MINIO_BUCKET=auth-profile
COMMUNITY_MINIO_ACCESS_KEY=fixture-community
COMMUNITY_MINIO_SECRET_KEY=fixture-community-secret-only
COMMUNITY_MINIO_BUCKET=memonogi-community-bucket
AUTOHEAL_INTERVAL=30
AUTOHEAL_START_PERIOD=0
AUTOHEAL_DEFAULT_STOP_TIMEOUT=10
AUTOHEAL_MEMORY_LIMIT=50m
AUTOHEAL_MEMORY_RESERVATION=20m
